{
  "name": "kairos-ai-quota-router",
  "version": "0.1.0",
  "private": true,
  "description": "Dashboard to track AI subscription quotas and get routing recommendations",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://codeberg.org/medenor/kairos.git"
  },
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:backend && npm run test:runner",
    "test:frontend": "node --test src/",
    "test:backend": "cd backend && npm test",
    "test:runner": "node --test runner/",
    "runner": "node runner/index.js",
    "lint": "eslint . && npm run lint:paths",
    "lint:paths": "scripts/check-local-paths.sh",
    "backend:start": "cd backend && npm start",
    "backend:dev": "cd backend && npm run dev",
    "backend:migrate": "cd backend && npm run migrate",
    "docker:build": "scripts/docker/build-image.sh",
    "docker:run:local": "scripts/docker/run-local.sh",
    "docker:run:selfhosted": "scripts/docker/run-selfhosted.sh",
    "docker:run:shared": "scripts/docker/run-shared.sh",
    "docker:verify": "scripts/docker/verify-container.sh",
    "docker:test:us1": "tests/integration/docker/us1-local-deploy.sh",
    "docker:test:us2": "tests/integration/docker/us2-selfhosted-health.sh",
    "docker:test:us3": "tests/integration/docker/us3-consistency-check.sh",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vite": "^5.4.0"
  }
}
